# CypherMind AI — FULL Kali arsenal image (kali-linux-everything).
# This is the HEAVY variant (~10-20 GB, long build). Needs internet at build time only.
#
# Build (Docker Desktop running):
#   cd backend/docker
#   docker build -t cyphermind/kali-everything:latest -f Dockerfile.kali-everything .
#   # ...go get a coffee, this pulls thousands of packages...
#
# Then point the app at it:
#   backend/.env -> EXEC_IMAGE=cyphermind/kali-everything:latest  and  EXEC_BACKEND=docker
#
# Once built, the container runs offline (reuses the image). You can also restrict its network
# to a lab subnet via EXEC_NET.

FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# 1) Doc-extraction tooling (man/apt-file) — its own light layer.
#    (no `tldr` — it's not an apt package on Kali rolling)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash coreutils curl wget git jq vim less ca-certificates openssl \
      man-db manpages manpages-dev apt-file bash-completion \
      python3 python3-pip python3-venv \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2) THE FULL ARSENAL (huge). Own layer. Retried up to 3x for transient network drops, but the
#    RUN FAILS if all attempts fail (so a broken build is never silently "successful").
RUN apt-get update \
 && ( apt-get install -y --no-install-recommends kali-linux-everything \
      || { echo ">> retry 2…"; sleep 10; apt-get update; apt-get install -y --no-install-recommends kali-linux-everything; } \
      || { echo ">> retry 3…"; sleep 15; apt-get update; apt-get install -y --no-install-recommends kali-linux-everything; } ) \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# 3) apt-file index for doc extraction (non-fatal).
RUN apt-get update && apt-file update || true; apt-get clean; rm -rf /var/lib/apt/lists/*

# A tiny local lab target so self-tests have something safe to hit (127.0.0.1).
# (Optional; many tools self-test with --version/--help and need no target.)
RUN python3 -m pip install --no-cache-dir --break-system-packages requests httpx dnspython || true

# OSINT arsenal: PhoneInfoga (Go binary) + pipx people-recon tools for the ```osint sweep.
RUN cd /tmp \
 && (curl -fsSL https://raw.githubusercontent.com/sundowndev/phoneinfoga/master/support/scripts/install | bash \
      && install -m755 ./phoneinfoga /usr/local/bin/phoneinfoga) || true \
 && pip install --no-cache-dir --break-system-packages holehe maigret h8mail sherlock-project theHarvester || true

# BeEF (Browser Exploitation Framework) — needs `bundle install` for its modern gem set (slow one-time build).
RUN apt-get update \
 && apt-get install -y beef-xss build-essential ruby-dev bundler libssl-dev libpcap-dev \
 && ( cd /usr/share/beef-xss && bundle config set --local frozen false && bundle install \
      && sed -i 's/passwd: *".*"/passwd: "CypherM1nd!"/; s/user: *".*"/user: "beef"/' config.yaml ) \
    || echo "WARN: beef bundle install incomplete" \
 ; apt-get clean && rm -rf /var/lib/apt/lists/*

# OWASP ZAP — CLI/headless Burp-Scanner equivalent (zaproxy -cmd -quickurl).
RUN apt-get update && apt-get install -y zaproxy && apt-get clean && rm -rf /var/lib/apt/lists/*

# Bluetooth stack + bluesnarfer (BlueSnarf attack) — needs a real BT radio at runtime (auto-detected).
RUN apt-get update && apt-get install -y bluez bluez-tools bluesnarfer libbluetooth3 && apt-get clean && rm -rf /var/lib/apt/lists/*

# SET (Social-Engineer Toolkit) — credential-harvester/phishing/QR/payload framework (driven non-interactively).
RUN apt-get update && apt-get install -y set && mkdir -p /root/.set && echo y > /root/.set/set.agreement && apt-get clean && rm -rf /var/lib/apt/lists/*

# Hound (geolocation + device recon) deps + clone — starts a PHP page behind a cloudflared tunnel.
RUN apt-get update && apt-get install -y php-cli wget unzip && git clone --depth 1 https://github.com/techchipnet/hound /root/hound && apt-get clean && rm -rf /var/lib/apt/lists/*

# CamPhish (webcam-grab + geolocation phishing) — clone (deps php/wget/unzip already installed above).
RUN git clone --depth 1 https://github.com/techchipnet/CamPhish /root/CamPhish

WORKDIR /workspace

# Keep the container alive so the app can `docker exec` into it.
CMD ["sleep", "infinity"]
